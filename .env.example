# NovelAI Writer Docker 环境变量配置

# 应用端口（映射到宿主机）
APP_PORT=3002

# 加密密钥（32位字符，用于加密API密钥）
# 首次启动后请勿更改，否则已保存的API密钥将无法解密
# 生成方式：openssl rand -hex 16
ENCRYPTION_KEY=

# ===== MCP(ChatGPT 接入)=====
# 认证模式:none(仅本地调试)/ token / oauth,公网部署必须非 none
MCP_AUTH_MODE=token
# token 模式:静态 Bearer 令牌(openssl rand -hex 24 生成)
MCP_STATIC_TOKEN=
# 对外基准 URL(域名),oauth 模式必填,token 模式用于元数据展示
MCP_PUBLIC_URL=https://your-domain.example.com
# oauth 模式:ChatGPT 首次连接时授权页的口令
MCP_OAUTH_PASSWORD=

# ===== Public Web(网页编辑界面公网暴露)=====
# 运行模式:local(默认,内网信任模型) / public(启用 Web 登录+CSRF+限流+密钥脱敏)
# public 启动检查(fail-fast):NODE_ENV=production、WEB_PUBLIC_URL/WEB_USERNAME/WEB_PASSWORD_HASH、
#   ENCRYPTION_KEY 必填、MCP_AUTH_MODE 禁止 none、HOST 禁止 0.0.0.0
APP_MODE=local

# Web 对外地址(Origin 校验/HSTS 用),public 模式必填
WEB_PUBLIC_URL=https://writer.example.com
# Web 登录用户名
WEB_USERNAME=
# Web 登录密码 scrypt 哈希,生成: node scripts/hash-password.mjs '你的密码'
WEB_PASSWORD_HASH=
# 会话有效期(小时),默认 168(7 天)
WEB_SESSION_TTL_HOURS=168

# 内部服务固定地址(public 模式下浏览器不可控,SSRF 收敛;local 模式沿用设置页配置)
CLIPROXY_BASE_URL=http://127.0.0.1:8317/v1
FUNASR_BASE_URL=http://127.0.0.1:3010
COMFYUI_BASE_URL=http://127.0.0.1:3011

# 监听地址:public 模式默认 127.0.0.1(由反向代理转发),显式 0.0.0.0 会被拒绝启动
HOST=127.0.0.1
